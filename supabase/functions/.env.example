# SMTP settings for the booking status emails (supabase/functions/_shared/bookingEmails.ts).
# Copy to supabase/functions/.env (gitignored — never commit it), fill in, then ask for it to be
# loaded into Supabase Vault as 'booking_smtp_config' (db/booking-requests/005). The Edge
# Functions read it from Vault; these variables are only the fallback if set as function secrets.
#
# Port must be 465 (SMTPS / implicit TLS): Supabase Edge Functions can't connect out on 25 or 587.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# The From address (usually the same mailbox as SMTP_USER) and the display name.
SMTP_FROM=
SMTP_FROM_NAME=Jaipur Rugs Bookings
# Optional: the employee portal's address, for the "Open the employee portal" link in each email.
EMPLOYEE_PORTAL_URL=

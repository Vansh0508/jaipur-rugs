# JRGPT — plain-English questions over the NAV mirror.
#
# Read-only by design: every question becomes a SELECT against the curated jrgpt.* views
# on the warehouse. The only thing this app writes is a user's pinned cards, which live in
# the shared Supabase project, never in the mirror.

# --- Warehouse (the NAV mirror on .18) ---
# Same variable apps/analytics uses. Server-side only; never reaches the browser.
# postgres://USER:PASSWORD@192.168.0.18:6543/postgres
WAREHOUSE_DATABASE_URL=

# --- Auth (Supabase, email OTP) ---
# The single Supabase project every app shares (AGENTS.md Section 3). Sign-in is OTP-only
# and never creates accounts — access is granted in Hub.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain that scopes the session cookie across subdomains (e.g. .jaipurrugs.com).
# Leave unset in local dev — the cookie stays host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Auth gate. False on localhost so the app opens without a mailbox; true once hosted.
# The plumbing (session, employee lookup, audit) runs either way — only the redirect is gated,
# so nothing has to be retrofitted when this flips.
JRGPT_REQUIRE_AUTH=false

# --- Model: text-to-SQL for anything outside the verified question library ---
#
# Two backends, same interface. The library answers verified questions instantly either
# way; the model only handles what it misses, and whatever it writes is still validated by
# lib/guards.ts before it can touch the warehouse.
#
# 1) Claude CLI (testing phase, uses the signed-in Claude account, no API key).
#    Install the CLI on this host, run `claude` once and `/login`, then point at the binary:
# JRGPT_CLAUDE_BIN=/usr/local/bin/claude
#
# 2) Anthropic API (production).
# ANTHROPIC_API_KEY=
#
# Force a backend instead of auto-detecting: cli | api | none
# JRGPT_MODEL_BACKEND=
# JRGPT_MODEL=claude-opus-5

# Every app gets the same shape of config, scoped to its own deployment (this one is
# on-premise, not Vercel — see README.md). Fill in the verified project values — do not
# assume `matnispbauvvlnbsuzxq` is the correct project by name alone (AGENTS.md Section 10).

# Use the new publishable key (Project Settings -> API Keys -> "Publishable key", looks
# like sb_publishable_...), not the legacy anon JWT — see
# https://supabase.com/docs/guides/getting-started/migrating-to-new-api-keys.
# NEXT_PUBLIC_SUPABASE_ANON_KEY still works as a fallback (lib/env.ts) if this is unset,
# but new deployments should only need this one.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Root domain used by packages/auth to scope the session cookie across every subdomain
# (e.g. .jaipurrugs.com). This app is on-premise rather than a *.jaipurrugs.com subdomain
# like every other app — confirm whether the cross-app-SSO cookie domain assumption still
# holds for however this is actually hosted before setting this in a real deployment.
# Leave unset in local dev — cookies fall back to host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Driver photos live in the `driver-photos` Supabase Storage bucket (public — see
# db/feedback/005_create_driver_photos_bucket.sql), same bucket the Feedback App reads.
# No separate S3 base URL needed — resolved directly from NEXT_PUBLIC_SUPABASE_URL.

# Leave unset (defaults to secure cookies — correct for a real HTTPS deployment).
# Set to "false" ONLY for a deployment you know is genuinely plain HTTP with no TLS —
# e.g. the internal-server deployment at 192.168.0.18. Found necessary 2026-09-02 on
# Atlas, hit again on CAD Layout: a `next build`/`next start` production build always
# sets NODE_ENV=production regardless of the actual connection, so packages/auth's old
# NODE_ENV-only default marked the session cookie Secure on a connection that could
# never satisfy it — sign-in "worked" but the browser silently refused to keep the
# cookie, bouncing back to /login forever.
NEXT_PUBLIC_COOKIE_SECURE=

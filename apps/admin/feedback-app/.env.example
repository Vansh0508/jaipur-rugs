# Every app gets the same shape of config, scoped to its own Vercel project (AGENTS.md,
# jaipur-rugs-monorepo-plan.md Section 6). Fill in the verified project values — do not
# assume `matnispbauvvlnbsuzxq` is the correct project by name alone (AGENTS.md Section 10).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used by packages/auth to scope the session cookie across every subdomain
# (e.g. .jaipurrugs.com). Leave unset in local dev — cookies fall back to host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# No separate S3 base URL needed — driver photos live in the `driver-photos` Supabase
# Storage bucket (public), resolved directly from NEXT_PUBLIC_SUPABASE_URL in lib/env.ts.
# This is a deliberate override of AGENTS.md's default self-hosted-S3 choice, recorded in
# AGENTS.md Section 1 (2026-08-18).

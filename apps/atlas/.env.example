# Every app gets the same shape of config, scoped to its own Vercel project (AGENTS.md
# Section 5). Fill in the verified project values — do not assume `matnispbauvvlnbsuzxq`
# is the correct project by name alone (AGENTS.md Section 10).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used by packages/auth to scope the staff session cookie across every
# subdomain (e.g. .jaipurrugs.com). Leave unset in local dev — cookies fall back to
# host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Where an unauthorized staff session gets bounced to (AGENTS.md's "Do": redirect to the
# Hub launcher instead of rendering an empty/broken department screen). Point this at
# Hub's real deployed URL; falls back to a relative /login on this app itself if unset,
# which is fine for local dev before Hub has its own subdomain wired up.
NEXT_PUBLIC_HUB_URL=

# No Clerk here — Atlas briefly used it for "merchants" (assumed external customers)
# before 2026-09-01's correction: those are actually internal Jaipur Rugs territory
# heads/B2B salespeople, so they use the same Supabase Auth staff login as everyone
# else. See db/orders/006_merchant_auth_consolidation.sql.

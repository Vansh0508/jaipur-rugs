# Every app gets the same shape of config, scoped to its own Vercel project (AGENTS.md
# Section 5). Fill in the verified project values — do not assume `matnispbauvvlnbsuzxq`
# is the correct project by name alone (AGENTS.md Section 10).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used by packages/auth to scope the staff session cookie across every
# subdomain (e.g. .jaipurrugs.com). Leave unset in local dev — cookies fall back to
# host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Where an unauthorized staff session gets bounced to (AGENTS.md's "Do": redirect to the
# Hub launcher instead of rendering an empty/broken department screen). Point this at
# Hub's real deployed URL; falls back to a relative /login on this app itself if unset,
# which is fine for local dev before Hub has its own subdomain wired up.
NEXT_PUBLIC_HUB_URL=

# No Clerk here — Atlas briefly used it for "merchants" (assumed external customers)
# before 2026-09-01's correction: those are actually internal Jaipur Rugs territory
# heads/B2B salespeople, so they use the same Supabase Auth staff login as everyone
# else. See db/orders/006_merchant_auth_consolidation.sql.

# Leave unset (defaults to secure cookies — correct for a real HTTPS deployment).
# Set to "false" ONLY for a deployment you know is genuinely plain HTTP with no TLS —
# e.g. the internal-server deployment at 192.168.0.18. Found necessary 2026-09-02: a
# `next build`/`next start` production build always sets NODE_ENV=production regardless
# of the actual connection, so packages/auth's old NODE_ENV-only default marked the
# session cookie Secure on a connection that could never satisfy it — sign-in "worked"
# but the browser silently refused to keep the cookie, bouncing back to /login forever.
NEXT_PUBLIC_COOKIE_SECURE=

# Server-only. Only needed to run scripts/orders-sync.mjs (the ERP pull, now run as a
# system cron job on the server, not a Supabase Edge Function — see that script's
# header comment and db/orders/007_orders_sync_move_to_server.sql for why). Bypasses
# RLS the same way the old Edge Function's built-in service role did, so keep it out of
# git and out of anything the browser loads — get it from the Supabase Dashboard's
# Project Settings -> API page, "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=

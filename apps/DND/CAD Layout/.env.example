# Same shape of config as every other app (AGENTS.md Section 5), scoped to this app's own
# deployment. Fill in the verified project values — do not assume `matnispbauvvlnbsuzxq`
# is the correct project by name alone (AGENTS.md Section 10).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used by packages/auth to scope the session cookie across subdomains
# (e.g. .jaipurrugs.com). Leave unset in local dev — cookies fall back to host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Set to "false" ONLY on a deployment that is genuinely plain HTTP (the internal office
# server is). `next start` always reports NODE_ENV=production, so without this the session
# cookie is marked Secure over plain HTTP, the browser drops it, and login loops back to
# /login forever — the exact bug Atlas hit on 2026-09-02. Leave unset for HTTPS.
NEXT_PUBLIC_COOKIE_SECURE=

# PDF export. The generate route converts the filled PPTX to PDF with LibreOffice
# (`soffice --headless --convert-to pdf`). Point this at the soffice binary if it isn't
# on PATH; on Windows dev machines without LibreOffice the converter falls back to
# PowerPoint via COM automation if Office is installed. Unset + neither available =>
# PPTX still downloads, PDF is reported as unavailable.
SOFFICE_PATH=

# Where generated jobs (PPTX/PDF + uploads) are written before download. Defaults to
# <os tmpdir>/cad-layout. Jobs older than CAD_LAYOUT_JOB_TTL_HOURS are swept on each
# generate call (default 24).
CAD_LAYOUT_JOB_DIR=
CAD_LAYOUT_JOB_TTL_HOURS=

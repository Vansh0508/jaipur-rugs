# Every app gets the same shape of config, scoped to its own Vercel project (AGENTS.md
# Section 5). Fill in the verified project values — do not assume `matnispbauvvlnbsuzxq` is
# the correct project by name alone (AGENTS.md Section 10).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Root domain used by packages/auth to scope the session cookie across every subdomain
# (e.g. .jaipurrugs.com) — Hub is the common interface every other app's session is shared
# with, so this matters here more than anywhere else. Leave unset in local dev — cookies
# fall back to host-only.
NEXT_PUBLIC_ROOT_DOMAIN=

# Employee avatars live in the `employee-avatars` Supabase Storage bucket (public — see
# db/team-members/006_hub_onboarding_and_admin.sql). No separate S3 base URL needed —
# resolved directly from NEXT_PUBLIC_SUPABASE_URL in lib/env.ts. Deliberate override of
# AGENTS.md's default self-hosted-S3 choice, recorded there in Section 1, same pattern as
# the Feedback App's driver-photos bucket.

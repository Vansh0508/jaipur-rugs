# Read when the server starts (not frozen into the build). Anything but "true" = real login.
SKETCH_CHALLAN_DEMO_MODE=true
# Optional: signs demo login cookies. If unset, one is generated into data/demo-secret.
SKETCH_CHALLAN_DEMO_SECRET=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ROOT_DOMAIN=
NEXT_PUBLIC_COOKIE_SECURE=false
SKETCH_CHALLAN_EXCEL_DIR=./data/excel-inbox
SKETCH_CHALLAN_MAP_RULES_DIR=./data/map-size-rules
# Read the NAV reports from the server's Supabase (schema nav_mirror) instead of the Excel inbox. Read-only login only.
NAV_DB_URL=
# Only if the nav_mirror table names differ from the defaults in lib/nav/mirror.ts:
# NAV_TABLE_145= NAV_TABLE_160= NAV_TABLE_028= NAV_TABLE_028_LIBRARY=
# Check sign-in passwords against the server's own Supabase (self-hosted). Unset = passwords from data/demo-accounts.json.
SKETCH_CHALLAN_AUTH_URL=
SKETCH_CHALLAN_AUTH_ANON_KEY=
# Sign in with employee code: the Supabase login is <code>@this domain (not a real mailbox).
SKETCH_CHALLAN_AUTH_EMAIL_DOMAIN=
# Sketcher roster, "Name:MC-no" pairs (staff data: only in .env.local, never in git). Unset = sample names.
NEXT_PUBLIC_SKETCH_CHALLAN_ROSTER=
